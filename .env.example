# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Platform admins need a two-factor (TOTP) session to use /admin. For local development only:
# set to true when your local Supabase has TOTP turned off. Production builds ignore it.
ADMIN_MFA_OPTIONAL=
# Where "Report a problem" links on client rooms and portfolios send reports (an abuse@ inbox).
# Defaults to the address the legal pages publish.
NEXT_PUBLIC_ABUSE_EMAIL=
# Optional: signs client-room unlock cookies (defaults to a key derived from the service role key).
# Set a separate 32+ char random value to rotate room access without rotating Supabase keys.
DELIVERY_ACCESS_SECRET=

# Cloudflare Stream Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_TOKEN=your-cloudflare-stream-token

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Zoho ZeptoMail Configuration (Transactional Emails, Waitlist, Collaborator Invites & Alerts)
# Get Send Mail Token from: Zoho ZeptoMail Console -> Mail Agents -> (Your Agent) -> Setup Info -> Send Mail Token
ZEPTOMAIL_API_TOKEN=Zoho-encztoken PHtE...
# Verified sender domain in ZeptoMail (e.g. noreply@cinespace.film or notifications@yourdomain.com)
ZEPTOMAIL_FROM_EMAIL=noreply@cinespace.film
ZEPTOMAIL_FROM_NAME=CineSpace
# Where replies to CineSpace's emails from Pedro go. Use an inbox someone reads: several emails say "reply to this email".
EMAIL_REPLY_TO=
# Regional API URL (default US/Global: https://api.zeptomail.com/v1.1/email)
# Use https://api.zeptomail.eu/v1.1/email for EU or https://api.zeptomail.in/v1.1/email for India
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Optional bounce address configured in ZeptoMail agent:
# ZEPTOMAIL_BOUNCE_ADDRESS=bounce@yourdomain.com

# The app's public URL, used for links in emails and WhatsApp messages (required in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp through Zoho CPaaS (ZeptoMail's new name; WhatsApp is in beta there). Setup: docs/notifications.md.
# Leave the token empty to keep WhatsApp off: nothing is sent, and the app says WhatsApp isn't available.
ZOHO_CPAAS_API_URL=https://cpaas.zoho.com
ZOHO_CPAAS_WHATSAPP_TOKEN=
# The WhatsApp Business sender number registered in Zoho CPaaS, with its country code (e.g. +9714...).
ZOHO_CPAAS_WHATSAPP_FROM=
# Template keys from the Zoho CPaaS console, one per message and language. A missing _AR key falls back to _EN.
ZOHO_CPAAS_WA_VERIFICATION_CODE_EN=
ZOHO_CPAAS_WA_VERIFICATION_CODE_AR=
ZOHO_CPAAS_WA_STUDIO_CUT_APPROVED_EN=
ZOHO_CPAAS_WA_STUDIO_CUT_APPROVED_AR=
ZOHO_CPAAS_WA_STUDIO_NEW_COMMENTS_EN=
ZOHO_CPAAS_WA_STUDIO_NEW_COMMENTS_AR=
ZOHO_CPAAS_WA_STUDIO_CLIENT_DOWNLOAD_EN=
ZOHO_CPAAS_WA_STUDIO_CLIENT_DOWNLOAD_AR=
ZOHO_CPAAS_WA_CLIENT_DELIVERY_READY_EN=
ZOHO_CPAAS_WA_CLIENT_DELIVERY_READY_AR=
# Development only: log WhatsApp messages instead of sending them (ignored in production).
# WHATSAPP_PROVIDER=mock

# Scheduled jobs: protects /api/cron/notifications (grouped WhatsApp comment alerts), sent as
# "Authorization: Bearer <secret>". At least 32 random characters; the route refuses to run without it.
CRON_SECRET=

# Optional legacy Resend configuration (fallback during migration)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Deployment Access Control
# Set to "true" to lock down the entire application to the waitlist only
WAITLIST_ONLY=true
# Optional: secret token to allow team preview (visit ?preview=YOUR_SECRET to unlock)
WAITLIST_BYPASS_SECRET=

# Cloudflare R2 Two-Bucket Configuration
# Public Bucket: for creator portfolios, avatars, showcase assets (public r2.dev or custom domain enabled)
CLOUDFLARE_R2_PUBLIC_BUCKET=cinespace-public
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# Private Bucket: for client deliveries and confidential cuts (public r2.dev strictly disabled)
CLOUDFLARE_R2_PRIVATE_BUCKET=cinespace-private
# Backward compatibility fallback bucket name:
CLOUDFLARE_R2_BUCKET=cinespace-saas
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# AWS S3 Glacier Deep Archive (The Silo — Cold Storage Archive)
# Kill switch: The Silo stays off (UI hidden, actions refused) unless "true" AND the AWS settings below are real.
SILO_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_SILO_BUCKET=cinespace-silo-archive
AWS_SILO_STORAGE_CLASS=DEEP_ARCHIVE
# Required when SILO_ENABLED=true: at least 32 random chars, sent as "Authorization: Bearer <secret>" (or as the Basic auth password)
SILO_WEBHOOK_SECRET=your-silo-webhook-secret

# Meta Pixel (public — used in browser)
NEXT_PUBLIC_META_PIXEL_ID=
# Set to "true" to fire the pixel in development. Leave unset/false in normal dev.
NEXT_PUBLIC_META_DEV_PIXEL=false
# Meta Conversions API access token (server-only).
# Generate from Meta Events Manager → Test Events → "Generate access token".
META_ACCESS_TOKEN=
# Set to "false" to disable server-side tracking without removing the token.
META_CAPI_ENABLED=true
# Optional: when set, server events appear in Meta's Test Events tool instead of production.
META_TEST_EVENT_CODE=

# PostHog (EU Cloud) — https://eu.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PROJECT_API_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://eu.i.posthog.com
# Set to "false" to disable PostHog entirely without removing the keys.
POSTHOG_ENABLED=true
# Set to "false" to disable session replay while keeping analytics.
POSTHOG_SESSION_REPLAY_ENABLED=true
