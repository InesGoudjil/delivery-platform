# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Stream Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_TOKEN=your-cloudflare-stream-token

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend Email Configuration (Transactional Emails & Waitlist)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Deployment Access Control
# Set to "true" to lock down the entire application to the waitlist only
WAITLIST_ONLY=true
# Optional: secret token to allow team preview (visit ?preview=YOUR_SECRET to unlock)
WAITLIST_BYPASS_SECRET=

# Cloudflare R2 Two-Bucket Configuration
# Public Bucket: for creator portfolios, avatars, showcase assets (public r2.dev or custom domain enabled)
CLOUDFLARE_R2_PUBLIC_BUCKET=cinespace-public
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# Private Bucket: for client deliveries and confidential cuts (public r2.dev strictly disabled)
CLOUDFLARE_R2_PRIVATE_BUCKET=cinespace-private
# Backward compatibility fallback bucket name:
CLOUDFLARE_R2_BUCKET=cinespace-saas
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Meta Pixel (public — used in browser)
NEXT_PUBLIC_META_PIXEL_ID=
# Set to "true" to fire the pixel in development. Leave unset/false in normal dev.
NEXT_PUBLIC_META_DEV_PIXEL=false
# Meta Conversions API access token (server-only).
# Generate from Meta Events Manager → Test Events → "Generate access token".
META_ACCESS_TOKEN=
# Set to "false" to disable server-side tracking without removing the token.
META_CAPI_ENABLED=true
# Optional: when set, server events appear in Meta's Test Events tool instead of production.
META_TEST_EVENT_CODE=

# PostHog (EU Cloud) — https://eu.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PROJECT_API_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://eu.i.posthog.com
# Set to "false" to disable PostHog entirely without removing the keys.
POSTHOG_ENABLED=true
# Set to "false" to disable session replay while keeping analytics.
POSTHOG_SESSION_REPLAY_ENABLED=true
